{
  "name": "ai-adventure-importer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && cp styles/ai-adventure-importer.css ai-adventure-importer.css && node scripts/verify-build.mjs",
    "deploy": "npm run build && pm2 restart foundry",
    "bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-adventure/bundle-schema": "*",
    "zod": "^3.23.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}